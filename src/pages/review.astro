---
import Base from '../layouts/Base.astro';
---

<Base
  title="Site Review Login · Agape Nursery"
  description="Private review tools for Agape Nursery website feedback."
>
  <main id="main" class="review-entry">
    <section class="review-entry-card">
      <p class="eyebrow">Private</p>
      <h1>Website review</h1>
      <p>
        Adolfo can log in here to mark up the live site with text notes and drawings,
        then send feedback to Kyle.
      </p>
      <p class="hint">Loading review gate…</p>
    </section>
  </main>
</Base>

<style>
  .review-entry {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
    background:
      radial-gradient(circle at top left, rgba(74, 93, 58, 0.18), transparent 40%),
      #f5f2eb;
  }
  .review-entry-card {
    max-width: 32rem;
    background: #fff;
    border-radius: 1.25rem;
    padding: 1.75rem;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }
  .eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #78716c;
    font-weight: 700;
  }
  h1 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    color: #1c1917;
  }
  p {
    margin: 0 0 0.75rem;
    color: #44403c;
    line-height: 1.55;
  }
  .hint {
    margin: 1rem 0 0;
    color: #78716c;
    font-size: 0.9rem;
  }
</style>
